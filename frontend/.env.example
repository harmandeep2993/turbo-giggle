# Copy this file to .env.local and fill in the values from the Azure Portal.
# Entra ID > Overview > Tenant ID
VITE_TENANT_ID=
# App registrations > calc-frontend > Application (client) ID
VITE_CLIENT_ID=
# App registrations > calc-api > Expose an API > the full scope
# e.g. api://<calc-api client id>/access-as-user
VITE_API_SCOPE=
# Where the backend runs
VITE_API_URL=http://localhost:8000
